DISCORD_TOKEN=put_discord_bot_token_here
YANDEX_MUSIC_TOKEN=put_yandex_music_token_here

# Вставляй только значения токенов: без русских подписей, без пробелов вокруг =,
# без строк вида "YANDEX_MUSIC_TOKEN=..." внутри значения.

# Необязательно: ограничить команды конкретными пользователями Discord.
# Можно указать несколько ID через запятую: 123,456
# Если оставить пустым и ALLOWED_ROLE_IDS тоже пустой, бот будет доступен всем на сервере.
ALLOWED_USER_IDS=

# Необязательно: владельцы бота.
# Если пусто, админ-действия доступны всем разрешенным пользователям.
OWNER_USER_IDS=

# Необязательно: ограничить команды ролями.
# Можно указать несколько ID через запятую: 123,456
ALLOWED_ROLE_IDS=

# Префикс команд.
COMMAND_PREFIX=!

# Необязательно: локальная настройка звука для проверки качества.
# Чтобы отключить фильтр, оставь пустым: FFMPEG_AUDIO_FILTER=
FFMPEG_AUDIO_FILTER=aresample=48000
FFMPEG_VOLUME=1.0
